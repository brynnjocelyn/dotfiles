# Restic S3/Minio Configuration
# Copy this to ~/.config/restic/env and fill in your credentials

# Minio endpoint
export AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY_HERE"
export AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY_HERE"

# Repository location (s3:endpoint/bucket)
export RESTIC_REPOSITORY="s3:http://10.27.27.155:9000/backups-thinkpad"

# Repository password (IMPORTANT: use a strong password, you'll need this to restore!)
export RESTIC_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"
